# Read.me: this R code gets the raw-data on the Live Birth Records(SINASC)
# from RMicrodatasus package available on Github
#-------------------------------------------------------------------------------


# Requirements ------------------------------------------------------------

#- run bellow to install
# install.packages("remotes")
#remotes::install_github("rfsaldanha/microdatasus")

# load packages
library(microdatasus)
library(here)


# Get the data ------------------------------------------------------------


## 2005-2006 ---------------------------------------------------------------


# create the list to save all the data by year
raw_data_list <- list()
raw_data_list <- list()


for (x in 2005:2006) {
  
  raw_data <- fetch_datasus(year_start = x, year_end = x, information_system = "SINASC")
  
  
  
  # add year as attribute to raw-data 
  attr(raw_data, "year") <- x
  
  # save raw-data in the list using the year as the name of it
  raw_data_list[[as.character(x)]] <- raw_data
  
  # save data as .RDS object with the respective year in the name of the file
  saveRDS(raw_data, paste0("./data/raw/health/SINASC/raw_data_", x, ".rds"))
  
  
}


raw_data_2005 <- readRDS("./data/raw/health/SINASC/raw_data_2005.rds")
df <- process_sinasc(raw_data_2005, municipality_data = TRUE)
saveRDS(df, "./data/raw/health/SINASC/process/raw_data_2005.rds")


raw_data_2006 <- readRDS("./data/raw/health/SINASC/raw_data_2006.rds")
df <- process_sinasc(raw_data_2006, municipality_data = TRUE)
saveRDS(df, "./data/raw/health/SINASC/process/raw_data_2006.rds")


